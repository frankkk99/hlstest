# Comma-separated HTTPS hosts that the tester may request.
ALLOWED_HLS_HOSTS=helvid.com,surrit.com,fourhoi.com

# Optional page hosts for the Player Extractor URL fetch mode.
# Pasted HTML mode does not need this setting.
ALLOWED_SOURCE_PAGE_HOSTS=missav123.com,missav.com,fourhoi.com,upload18.org

# Optional extra media hosts for Player Extractor server-side tests.
ALLOWED_EXTRACT_MEDIA_HOSTS=surrit.com,fourhoi.com

# Server-only Upload18 account used only when AVDB Player verification reaches the Upload18 login gate.
# Never expose these with NEXT_PUBLIC_ prefix and never store them in Supabase.
UPLOAD18_USERNAME=
UPLOAD18_PASSWORD=

# Enabled by default for production playback. Set false to force direct browser playback.
ENABLE_STREAM_PROXY=true

# Optional CSP frame-ancestors value for /embed/*.
# Default is * so the Gateway can be embedded anywhere. Restrict in production when client domains are fixed.
# Example: PLAYER_GATEWAY_FRAME_ANCESTORS='self' https://real2free.example https://doodee.example
PLAYER_GATEWAY_FRAME_ANCESTORS=*

# aaPanel/VPS: point Puppeteer to the system Chrome/Chromium binary.
# Run `which google-chrome-stable`, `which google-chrome`, or `which chromium` on the server.
# If omitted, common Linux paths are auto-detected, then @sparticuz/chromium is used as fallback.
CHROMIUM_EXECUTABLE_PATH=

# Server-only credentials for the hlshub schema in Alphalab Hub.
# Never expose the service-role key with NEXT_PUBLIC_ prefix.
HLSHUB_SUPABASE_URL=https://qlunnckudeynhruxzpnb.supabase.co
HLSHUB_SUPABASE_SERVICE_ROLE_KEY=

# Password for the protected /admin area. Keep this server-only.
HLSHUB_ADMIN_PASSWORD=

# Optional independent signing secret for admin sessions.
HLSHUB_ADMIN_SESSION_SECRET=

# Required to use the protected repair console at /admin/player-repair.
# Never expose either value with NEXT_PUBLIC_ prefix.
HLSHUB_ADMIN_KEY=

# Optional override for upstream requests.
# HLS_TEST_USER_AGENT=Mozilla/5.0 ...
